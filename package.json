{
  "name": "ds-agentshell",
  "version": "0.2.0",
  "description": "DS-AgentShell: an unofficial Electron desktop wrapper for DeepSeek Harness (bundles the dsh web backend).",
  "author": "DS-AgentShell",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "gen-icon": "node scripts/gen-original-icon.cjs",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "@resvg/resvg-js": "^2.6.0"
  },
  "build": {
    "appId": "com.ds-agentshell.desktop",
    "productName": "DS-AgentShell",
    "copyright": "MIT",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "ds-agentshell.config.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DS-AgentShell",
      "artifactName": "DS-AgentShell-Setup-${version}.${ext}"
    }
  }
}
